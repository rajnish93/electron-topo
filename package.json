{
  "name": "nuxt-electron",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "My Electron application description",
  "version": "1.0.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "make": "pnpm generate && electron-forge make"
  },
  "license": "MIT",
  "dependencies": {
    "@primeuix/themes": "^1.0.3",
    "@primevue/forms": "^4.3.3",
    "cytoscape": "^3.31.1",
    "cytoscape-context-menus": "^4.2.1",
    "electron-squirrel-startup": "^1.0.1",
    "get-port": "^7.1.0",
    "mime-types": "^3.0.1",
    "nuxt": "^3.17.1",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.2.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/publisher-github": "^7.8.1",
    "@nuxt/eslint": "1.3.0",
    "@nuxt/fonts": "0.11.2",
    "@nuxt/icon": "1.12.0",
    "@nuxt/image": "1.10.0",
    "@nuxt/test-utils": "3.17.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "0.11.0",
    "@primevue/nuxt-module": "^4.3.3",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/cytoscape-context-menus": "^4.1.4",
    "@types/mime-types": "^2.1.4",
    "electron": "^36.2.0",
    "electron-prebuilt-compile": "8.2.0",
    "eslint": "^9.25.1",
    "husky": "^9.1.7",
    "nuxt-electron": "0.7.0",
    "nuxt-lodash": "^2.5.3",
    "sass-embedded": "^1.87.0",
    "typescript": "^5.8.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "nuxt-electron",
        "executableName": "nuxt-electron"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-deb",
          "platforms": [
            "linux"
          ],
          "config": {
            "maintainer": "Test",
            "icon": "public/images/logos/HBD.png",
            "overwrite": true
          }
        },
        {
          "name": "@electron-forge/maker-dmg",
          "platforms": [
            "darwin"
          ],
          "config": {
            "background": "public/images/logos/HBD.png",
            "icon": "public/images/logos/HBD.png",
            "format": "ULFO",
            "overwrite": true
          }
        },
        {
          "name": "@electron-forge/maker-squirrel",
          "platforms": [
            "win32"
          ]
        }
      ],
      "publishers": [
        {
          "name": "@electron-forge/publisher-github",
          "config": {
            "repository": {
              "owner": "stackvue",
              "name": "nuxt-electron"
            },
            "prerelease": true
          }
        }
      ]
    }
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
